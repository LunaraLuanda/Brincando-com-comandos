Algoritmo "Brincando com comandos"
// Disciplina   : [Linguagem e Lógica de Programação]
// Professor   : Gustavo Guanabara 
// Autor(a)    : Lunara Lago
// Data atual  : 11/11/2026
Var
// Seção de Declarações das variáveis 
   brocolis: inteiro
Inicio
// Seção de Comandos, procedimento, funções, operadores, etc...
// Enquanto seu prato estiver com brócolis, você não vai brincar
   brocolis <- 3

   Escreval("Quantos pedaços de brócolis há: ", brocolis)
   enquanto brocolis > 0 faca
      escreval("Comendo uma garfada! Sobraram: ", brocolis)
      brocolis <- brocolis - 1
   fimenquanto

   escreval("Prato limpo! Pode ir brincar!")
Fimalgoritmo